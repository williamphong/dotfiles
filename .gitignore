# macos
.DS_Store

# ignore backup, swap, and undo files from nvim
*~
*.*~
*.swp
*.undo
.config/tmux/plugins/

# spicetify installs third-party themes, extensions and custom apps here.
# Only config-xpui.ini is actually ours; the rest is 70M of vendored upstream
# code that spicetify re-fetches on install.
.config/spicetify/Themes/
.config/spicetify/CustomApps/
.config/spicetify/Extensions/

# stale tpm location; plugins now live under .config/tmux/plugins
.tmux/

# never track ssh material -- private keys, and a config that would leak
# hostnames and internal IPs into a public repo
.ssh/
*.pem
id_rsa*
id_ed25519*
known_hosts*
